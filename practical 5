#include<iostream> #include<string> using namespace std; #define MAX 5 class cq { string queue[MAX]; int front, rear; public: cq() { front = -1; rear = -1; } // Enqueue Operation void enqueue(string name) { if (rear == MAX - 1) { cout << "QUEUE IS FOLL!! CUSTOMER CANNOT BE ADDED!" << endl; return; } if (front == -1) front = 0; rear++; queue[rear]=name; cout << name << " has joined the queue\n." << endl; } // Dequeue Operation void dequeue()

{ if (front == -1 || front > rear) { cout << "QUEUE UNDERFLOW!" << endl; return; } cout << queue[front] << " HAS BEEN SERVED\n." << endl; front++; if (front > rear) { front = rear = -1; } } // Display Operation void display() { if (front == -1) { cout << "no customers are waiting" << endl; return; } cout << " Customers wiating in Queue "; for (int i = front; i <= rear; i++) { cout << i-front+1 <<"."<< queue[i] <<endl; } cout << endl; } }; int main()

{ cq c; int choice; string name; do { cout << "\n------ Queue Using Array ------"; cout << "\n1. Add customer"; cout << "\n2. serve customer"; cout << "\n3. display waiting customers"; cout << "\n4. exit"; cout << "\nEnter your choice: "; cin >> choice; switch (choice) { case 1: cout << "Enter customer name: "; cin >> name; c.enqueue(name); break; case 2: c.dequeue(); break; case 3: c.display(); break; case 4: cout << "Exiting Program..." << endl; break; default: cout << "Invalid Choice!" << endl; }
} while (choice != 5); return 0; }
